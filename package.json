{
  "name": "gh-ui",
  "productName": "gh-ui",
  "license": "MIT",
  "homepage": "https://github.com/PlaygrndLabs/gh-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlaygrndLabs/gh-ui.git"
  },
  "version": "0.1.0",
  "description": "A GitHub client with the github.com interface, native desktop shell, and a built-in code review agent.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p worker/tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:dev": "concurrently -k \"vite --port 5174 --strictPort\" \"wait-on tcp:5174 && cross-env GH_UI_DEV_URL=http://localhost:5174 electron .\"",
    "electron:build": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "test:e2e:desktop": "npm run build && sh scripts/e2e-desktop.sh"
  },
  "build": {
    "appId": "dev.gh-ui.app",
    "productName": "gh-ui",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "electron/**/*",
      "!electron/**/*.test.ts",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "CFBundleDisplayName": "GitHub UI"
      },
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "GitHub-UI-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@octokit/rest": "^22.0.1",
    "@primer/octicons-react": "^19.42.0",
    "@primer/primitives": "^11.10.0",
    "@primer/react": "^38.43.0",
    "@tanstack/react-query": "^5.105.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "blakejs": "^1.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.17",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tweetnacl": "^1.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1",
    "wrangler": "^4.156.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true,
    "fsevents@2.3.3": true
  }
}
